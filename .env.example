# Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Private founder-console access. Generate a long random value and store it only
# in the deployment/runtime environment. Never expose it as NEXT_PUBLIC_*.
FOUNDER_CONSOLE_ACCESS_KEY=

# Future Supabase Auth/RLS integration. These are placeholders only; the current
# foundation does not write chat/runtime rows to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional future server-only admin adapter. Do not use for normal user-owned
# chat/artifact/task persistence. Keep unset until an allowlisted admin adapter exists.
SUPABASE_SERVICE_ROLE_KEY=
